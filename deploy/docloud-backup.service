[Unit]
Description=DOCLOUD daily online backup
[Service]
Type=oneshot
User=docloud
Group=docloud
WorkingDirectory=/srv/docloud/app
EnvironmentFile=/etc/docloud.env
ExecStart=/usr/bin/node scripts/backup.mjs
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/docloud/data /srv/docloud/backups
